# Copia este archivo a .env y llena los valores. Nunca subas el .env.
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000

# Cloudflare AI Gateway (solo con MODEL_PROVIDER=gateway)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Produccion segura (con ENVIRONMENT=production se aplican las reglas de
# doc/compliance-checklist.md). API_KEYS es un secreto: cliente:clave,cliente2:clave2
# y cada clave con al menos 16 caracteres. Nunca la subas al repositorio.
ENVIRONMENT=development
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# Trazas opcionales
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true
